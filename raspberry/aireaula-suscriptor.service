[Unit]
Description=AireAula - suscriptor MQTT, SQLite y Firebase
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=/opt/aireaula
EnvironmentFile=/opt/aireaula/.env
ExecStart=/opt/aireaula/venv/bin/python /opt/aireaula/suscriptor.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
